# .env.example — Sao chép thành .env và điền giá trị thực. Không commit file .env lên git.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT
SECRET_KEY=

# AI Provider (openrouter | openai)
AI_PROVIDER=openrouter

# OpenRouter (mặc định)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# OpenAI (chỉ dùng khi AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
